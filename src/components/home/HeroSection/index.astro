---
import { ArrowDown } from "lucide-react";
import profileImg from "@/assets/images/salah/me-cropped.jpg";
import HeroBackground from "./HeroBackground";
import SectionWrapper from "@/layouts/SectionWrapper.astro";
import { Image } from "astro:assets";
---

<section id="home" class="relative min-h-dvh flex items-center overflow-hidden">
	<HeroBackground client:idle />

	<SectionWrapper
		className="flex flex-col sm:flex-row items-center gap-24 sm:justify-between"
	>
		<!-- Text -->
		<div class="flex-1 text-center md:text-left">
			<p
				data-aos="fade-up"
				data-aos-delay="200"
				data-aos-duration="600"
				data-aos-once="true"
				data-aos-easing="ease-out-cubic"
				class="mb-4 text-sm font-medium tracking-widest uppercase text-primary"
			>
				Front-End Developer
			</p>
			<h1
				data-aos="fade-up"
				data-aos-delay="300"
				data-aos-duration="600"
				data-aos-once="true"
				data-aos-easing="ease-out-cubic"
				class="font-heading text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl"
			>
				Building Digital{" "}
				<span class="text-gradient glow-text">Experiences</span>{" "}
				that Matter
			</h1>
			<p
				data-aos="fade-up"
				data-aos-delay="500"
				data-aos-duration="600"
				data-aos-once="true"
				data-aos-easing="ease-out-cubic"
				class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground md:text-xl"
			>
				Hi, I'm <span class="text-foreground font-semibold">Salah Mohamed</span
				>. I craft high-performance, pixel-perfect web applications with React &
				TypeScript. Passionate about clean code, scalable architecture, and
				delightful user interfaces.
			</p>
			<div
				data-aos="fade-up"
				data-aos-delay="700"
				data-aos-duration="600"
				data-aos-once="true"
				data-aos-easing="ease-out-cubic"
				class="mt-8 flex flex-wrap gap-4 justify-center md:justify-start"
			>
				<a
					href="#work"
					class="rounded-lg bg-primary px-7 py-3 font-semibold text-primary-foreground transition-all hover:opacity-90 glow"
				>
					View My Work
				</a>
				<a
					href="#contact"
					class="rounded-lg border border-border bg-secondary px-7 py-3 font-semibold text-secondary-foreground transition-all hover:bg-muted"
				>
					Contact Me
				</a>
			</div>
		</div>

		<!-- Profile Image -->
		<div
			data-aos="zoom-in"
			data-aos-delay="400"
			data-aos-duration="600"
			data-aos-once="true"
			data-aos-easing="ease-out-cubic"
			class="shrink-0"
		>
			<div class="relative">
				<div
					class="absolute -inset-1 rounded-full bg-linear-to-br from-primary/40 to-primary/10 blur-2xl"
				>
				</div>
				<Image
					src={profileImg}
					alt="Salah Mohamed"
					class="relative z-10 max-h-64 max-w-64 size-full aspect-square rounded-full border-2 border-primary/30 object-cover shadow-2xl sm:max-h-80 sm:max-w-80"
				/>
			</div>
		</div>
	</SectionWrapper>

	<!-- Scroll indicator -->
	<div
		data-aos="fade"
		data-aos-delay="1200"
		data-aos-duration="600"
		data-aos-once="true"
		data-aos-easing="ease-out-cubic"
		class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2"
	>
		<a
			href="#about"
			class="flex flex-col items-center gap-2 text-muted-foreground hover:text-primary transition-colors"
		>
			<span class="text-xs tracking-wider uppercase">Scroll</span>
			<ArrowDown size={16} className="animate-bounce" />
		</a>
	</div>
</section>
