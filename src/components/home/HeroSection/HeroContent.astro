---
import { SOCIAL_MEDIA } from "@/constants/social-media";
import { buttonVariants } from "@/components/ui/button";
import ExternalLink from "@/components/common/ExternalLink.astro";
---

<div class="flex-1 text-center md:text-left">
	<p
		data-aos="fade-up"
		data-aos-delay="200"
		data-aos-duration="600"
		data-aos-once="true"
		data-aos-easing="ease-out-cubic"
		class="mb-4 text-sm font-medium font-heading tracking-widest uppercase text-primary"
	>
		- Front-End Developer
	</p>
	<h1
		data-aos="fade-up"
		data-aos-delay="300"
		data-aos-duration="600"
		data-aos-once="true"
		data-aos-easing="ease-out-cubic"
		class="font-heading text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl"
	>
		Building Digital{" "}
		<span class="text-gradient glow-text">Experiences</span>{" "}
		that Matter
	</h1>
	<p
		data-aos="fade-up"
		data-aos-delay="500"
		data-aos-duration="600"
		data-aos-once="true"
		data-aos-easing="ease-out-cubic"
		class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground md:text-xl"
	>
		Hi, I'm <span class="text-foreground font-semibold">Salah Mohamed</span>. I
		craft high-performance, pixel-perfect web applications with React &
		TypeScript. Passionate about clean code, scalable architecture, and
		delightful user interfaces.
	</p>
	<div
		data-aos="fade-up"
		data-aos-delay="700"
		data-aos-duration="600"
		data-aos-once="true"
		data-aos-easing="ease-out-cubic"
		class="mt-8 flex flex-wrap *:max-w-44 *:w-full gap-4 justify-center md:justify-start"
	>
		<a href="#work" class={buttonVariants({ variant: "default", size: "lg" })}>
			View My Work
		</a>
		<a
			href="#contact"
			class={buttonVariants({ variant: "secondary", size: "lg" })}
		>
			Contact Me
		</a>
	</div>
	<div
		data-aos="fade-up"
		data-aos-delay="900"
		data-aos-duration="600"
		data-aos-once="true"
		data-aos-easing="ease-out-cubic"
		class="mt-6 flex gap-3 justify-center md:justify-start"
	>
		{
			SOCIAL_MEDIA.map((social) => (
				<ExternalLink
					href={social.href}
					label={social.label}
					icon={social.icon}
				>
					<social.icon className="size-4" />
				</ExternalLink>
			))
		}
	</div>
</div>
