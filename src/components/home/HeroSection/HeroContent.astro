---
import { SOCIAL_MEDIA } from "@/constants/social-media";
import { buttonVariants } from "@/components/ui/button";
import ExternalLink from "@/components/common/ExternalLink.astro";
import { AnimateOnView } from "@/components/ui/AnimateOnView";
import { HeroHeading } from "./HeroHeading";
---

<div class="flex-1 text-center md:text-left">
	<!-- Subtitle: TextAnimateIsland — word-by-word blurInUp -->
	<AnimateOnView
		animation="fade-up"
		delay={50}
		duration={500}
		once
		easing="ease-out-cubic"
		client:load
	>
		<p
			class="mb-4 text-sm font-medium font-heading tracking-widest uppercase text-primary"
		>
			- Front-End Developer
		</p>
	</AnimateOnView>
	<!-- Heading: single React island — coordinates all three segments via variant propagation -->
	<HeroHeading client:load />

	<!-- Description: AnimateOnView — preserves <span> bold on "Salah Mohamed" -->
	<AnimateOnView
		animation="fade-up"
		delay={1100}
		duration={600}
		once
		easing="ease-out-cubic"
		client:load
	>
		<p
			class="mt-6 max-w-lg text-lg leading-relaxed text-muted-foreground md:text-xl"
		>
			Hi, I'm <span class="text-foreground font-semibold">Salah Mohamed</span>.
			I craft high-performance, pixel-perfect web applications with React &
			TypeScript. Passionate about clean code, scalable architecture, and
			delightful user interfaces.
		</p>
	</AnimateOnView>

	<!-- CTA Buttons: AnimateOnView -->
	<AnimateOnView
		animation="fade-up"
		delay={1350}
		duration={500}
		once
		easing="ease-out-cubic"
		client:load
	>
		<div
			class="mt-8 flex flex-wrap *:max-w-44 *:w-full gap-4 justify-center md:justify-start"
		>
			<a
				href="#work"
				class={buttonVariants({ variant: "default", size: "lg" })}
			>
				View My Work
			</a>
			<a
				href="#contact"
				class={buttonVariants({ variant: "secondary", size: "lg" })}
			>
				Contact Me
			</a>
		</div>
	</AnimateOnView>

	<!-- Social Links: staggered AnimateOnView per icon -->
	<div class="mt-6 flex gap-3 justify-center md:justify-start">
		{
			SOCIAL_MEDIA.map((social, index) => (
				<AnimateOnView
					animation="fade-up"
					delay={1550 + index * 100}
					duration={400}
					once
					easing="ease-out-cubic"
					client:load
				>
					<ExternalLink
						href={social.href}
						label={social.label}
						icon={social.icon}
					>
						<social.icon className="size-4" />
					</ExternalLink>
				</AnimateOnView>
			))
		}
	</div>
</div>
