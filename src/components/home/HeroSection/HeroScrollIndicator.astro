---
import { FiArrowDown } from "react-icons/fi";
import { AnimateOnView } from "@/components/ui/AnimateOnView";
---

<AnimateOnView
	animation="fade"
	delay={1200}
	duration={600}
	once
	easing="ease-out-cubic"
	offset={100}
	className="absolute bottom-16 left-1/2 z-10 -translate-x-1/2"
	client:load
>
	<a
		href="#about"
		class="flex flex-col items-center gap-2 text-muted-foreground hover:text-primary transition-colors"
	>
		<span class="text-xs tracking-wider uppercase">Scroll</span>
		<FiArrowDown size={16} className="animate-bounce" />
	</a>
</AnimateOnView>
