---
import FooterNav from "./FooterNav.astro";
import FooterSocials from "./FooterSocials.astro";
import ScrollToTop from "./ScrollToTop";
---

<footer class="border-t border-border bg-card">
	<div class="mx-auto max-w-6xl px-6 py-12">
		<div
			class="flex flex-col items-center gap-8 sm:flex-row sm:justify-between"
		>
			<a
				href="#home"
				class="font-heading text-xl font-bold tracking-tight text-foreground"
			>
				Salah<span class="text-primary">.</span>
			</a>

			<FooterNav />

			<div class="flex items-center gap-3">
				<FooterSocials />
				<ScrollToTop client:visible />
			</div>
		</div>

		<div
			class="mt-8 flex flex-col items-center gap-2 border-t border-border pt-8 sm:flex-row sm:justify-between"
		>
			<p class="text-sm text-muted-foreground">
				&copy; {new Date().getFullYear()} Salah Mohamed. All rights reserved.
			</p>
			<p class="text-xs text-muted-foreground">
				Built with React & Tailwind CSS
			</p>
		</div>
	</div>
</footer>
