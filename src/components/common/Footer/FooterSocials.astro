---
import { SOCIAL_MEDIA } from "@/constants/social-media";
---

<div class="flex items-center gap-3">
	{
		SOCIAL_MEDIA.map((social) => (
			<a
				href={social.href}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={social.label}
				class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted-foreground transition-all hover:border-primary hover:text-primary"
			>
				<social.icon className="size-4" />
			</a>
		))
	}
</div>
